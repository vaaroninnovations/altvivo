+    def test_exempt_paths_and_logout_and_topbar(self):
+        self.assertEqual(self.get('/healthz').status_code, 200)
+        hook = self.c.post('/api/resend/inbound', {}, secure=True)  # webhook: never sent to the AltVivo login
+        self.assertFalse(hook.has_header('Location'))
+        tok, _ = token()
+        self.get('/modules/', tok)
+        u = User.objects.get(pk=self.uid())
+        u.consent_version = settings.POLICY_VERSION
+        u.save()
+        page = self.get('/modules/', tok)
+        self.assertEqual(page.status_code, 200)
+        self.assertContains(page, '<altvivo-topbar app="xprism" api="https://api.altvivo.bio" home="https://altvivo.bio" logo=')
+        self.assertEqual(page.content.count(b'<altvivo-topbar'), 1)
+        # One bar: XPRISM's logo and menu sit inside it, its own header and tab row are gone.
+        self.assertContains(page, '<a slot="brand" href="/"')
+        self.assertContains(page, '>My data</a>')
+        self.assertNotContains(page, 'xp-subnav')
+        self.assertNotContains(page, 'site-header xp-header')
+        self.assertEqual(page.content.count(b'embed.altvivo.bio/bar.js'), 1)
+        r = self.c.post('/accounts/logout/', secure=True)
+        self.assertEqual(r['Location'], 'https://altvivo.bio/logout?next=https%3A%2F%2Fxprism.altvivo.bio%2F')
