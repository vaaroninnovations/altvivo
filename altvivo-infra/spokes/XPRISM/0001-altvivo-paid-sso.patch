+# syntax=docker/dockerfile:1.7
+# XPRISM - Django 5 CAL pharmacology simulator, served at xprism.altvivo.bio
+# behind Caddy (forward_auth paid gate) + lab/altvivo_sso_middleware.py.
+#
+#   docker compose build xprism            (from /opt/altvivo/altvivo-infra)
+#   docker build -t altvivo/xprism .       (standalone)
+ARG PYTHON_IMAGE=python:3.12.15-slim-trixie
+
+# ----------------------------------------------------------------- build ----
+FROM ${PYTHON_IMAGE} AS build
+ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1
+WORKDIR /app
+COPY requirements.txt .
+RUN python -m venv /opt/venv && /opt/venv/bin/pip install --upgrade pip && /opt/venv/bin/pip install -r requirements.txt
+COPY . .
+# Static files are collected into the image and served by WhiteNoise
+# (URLs carry ?v=<mtime>, so they are cached for 30 days).
+RUN DJANGO_SECRET_KEY=build-only-not-a-secret DJANGO_STATIC_ROOT=/app/staticfiles \
+    /opt/venv/bin/python manage.py collectstatic --noinput --verbosity 0
+
+# --------------------------------------------------------------- runtime ----
+FROM ${PYTHON_IMAGE}
+RUN groupadd --system --gid 10001 xprism \
+ && useradd --system --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin xprism
+ENV PATH=/opt/venv/bin:$PATH \
+    PYTHONDONTWRITEBYTECODE=1 \
+    PYTHONUNBUFFERED=1 \
+    DJANGO_STATIC_ROOT=/app/staticfiles \
+    XPRISM_SERVE_STATIC=true
+WORKDIR /app
+# Code is root-owned and read-only to the service user.
+COPY --from=build /opt/venv /opt/venv
+COPY --from=build /app /app
+USER 10001:10001
+EXPOSE 8000
+HEALTHCHECK --interval=20s --timeout=5s --start-period=40s --retries=4 \
+  CMD python -c "import urllib.request as u,sys;r=u.Request('http://127.0.0.1:8000/healthz',headers={'Host':'xprism.altvivo.bio','X-Forwarded-Proto':'https'});sys.exit(0 if u.urlopen(r,timeout=4).status==200 else 1)"
+# Bind address, workers and timeouts come from GUNICORN_CMD_ARGS (compose).
+CMD ["gunicorn", "config.wsgi:application"]
