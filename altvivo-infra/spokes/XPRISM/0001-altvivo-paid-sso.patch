+"""Tests for lab/altvivo_sso_middleware.py (AltVivo SSO + paid gate).
+
+Run with SSO switched on; the tests write their own JWKS to that path:
+
+    ALTVIVO_JWKS_URL=file:///tmp/altvivo-jwks.json python manage.py test lab.tests_altvivo
+
+Skipped when ALTVIVO_JWKS_URL is not set. (With SSO on, every non-exempt
+page requires a paid AltVivo session, so run XPRISM's main suite without it.)
+"""
+import json
+import os
+import time
+import unittest
+import uuid
+from pathlib import Path
+from urllib.parse import parse_qs, urlparse
+from urllib.request import url2pathname
+
+from django.conf import settings
+from django.test import Client, TestCase, override_settings
+
+from .models import AuditLog, College, Role, User
+
+ENABLED = getattr(settings, 'ALTVIVO_SSO_ENABLED', False)
+HOST = 'xprism.altvivo.bio'
+
+if ENABLED:
+    import jwt
+    from cryptography.hazmat.primitives import serialization
+    from cryptography.hazmat.primitives.asymmetric import rsa
+
+    from . import altvivo_sso_middleware as sso
+
+    KEY = rsa.generate_private_key(public_exponent=65537, key_size=2048)
+    PEM = KEY.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption())
+
+
+class FakeRedis:
+    def __init__(self):
+        self.store = {}
+
+    def mget(self, *keys):
+        return [self.store.get(k) for k in keys]
+
+
+def token(**over):
+    now = int(time.time())
+    claims = {
+        'sub': str(uuid.uuid4()), 'sid': str(uuid.uuid4()), 'email': 'priya@uni.edu.in', 'name': 'Priya Raman',
+        'role': 'RESEARCHER', 'org_id': None, 'tier': 'XPRISM_ANNUAL', 'email_verified': True, 'mfa': False,
+        'entitlements': {
+            'xprism': {'active': True, 'level': 'full', 'source': 'subscription', 'plan': 'xprism_annual', 'expires_at': now + 30 * 86400},
+            'amaze': {'active': False, 'level': 'none', 'source': None, 'plan': None, 'expires_at': None},
+        },
+        'iat': now, 'exp': now + 900, 'iss': 'https://api.altvivo.bio', 'jti': 'j',
+    }
+    claims.update(over)
+    return jwt.encode(claims, PEM, algorithm='RS256', headers={'kid': 'xprism-test'}), claims
+
+
+@unittest.skipUnless(ENABLED, 'ALTVIVO_JWKS_URL not set: AltVivo SSO disabled')
+@override_settings(ALLOWED_HOSTS=[HOST, 'testserver'], SECURE_SSL_REDIRECT=False)
+class AltVivoPaidGateTests(TestCase):
+    @classmethod
+    def setUpClass(cls):
+        super().setUpClass()
+        jwk = json.loads(jwt.algorithms.RSAAlgorithm.to_jwk(KEY.public_key()))
+        path = Path(url2pathname(urlparse(os.environ['ALTVIVO_JWKS_URL']).path))
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(json.dumps({'keys': [{**jwk, 'kid': 'xprism-test', 'alg': 'RS256', 'use': 'sig'}]}))
+
+    def setUp(self):
+        sso.reset_caches()
+        self.redis = FakeRedis()
+        sso.set_redis(self.redis)
+        self.c = Client(HTTP_HOST=HOST)
+
+    def get(self, path, tok=None, json_api=False):
+        if tok is not None:
+            self.c.cookies['altvivo_at'] = tok
+        headers = {'HTTP_ACCEPT': 'application/json'} if json_api else {'HTTP_ACCEPT': 'text/html'}
+        return self.c.get(path, secure=True, **headers)
+
+    def uid(self):
+        return self.c.session.get('_auth_user_id')
+
+    # ------------------------------------------------------------------ --
+    def test_unauthenticated_is_sent_to_altvivo_login(self):
+        r = self.get('/modules/?x=1')
+        self.assertEqual(r.status_code, 302)
+        self.assertEqual(r['Location'], 'https://altvivo.bio/login?redirect=https%3A%2F%2Fxprism.altvivo.bio%2Fmodules%2F%3Fx%3D1')
+        api = self.get('/api/experiments/x/feedback', json_api=True)
+        self.assertEqual((api.status_code, api.json()['error']), (401, 'unauthenticated'))
+
+    def test_unpaid_is_sent_to_upgrade(self):
+        now = int(time.time())
+        cases = [
+            {'xprism': {'active': False, 'level': 'none', 'expires_at': None}},
+            {'xprism': {'active': True, 'level': 'full', 'expires_at': now - 10}},
+            {},
+            {'xprism': 'full'},  # legacy string shape is not a paid entitlement
+        ]
+        for ents in cases:
+            tok, _ = token(entitlements=ents)
+            r = self.get('/modules/', tok)
+            self.assertEqual(r.status_code, 302, ents)
+            q = parse_qs(urlparse(r['Location']).query)
+            self.assertEqual(r['Location'].split('?')[0], 'https://altvivo.bio/workspace/upgrade')
+            self.assertEqual(q['app'], ['xprism'])
+            self.assertIn(q['reason'][0], ('subscription_required', 'subscription_expired'))
+            self.assertIsNone(self.uid())
+
+    def test_paid_user_is_created_signed_in_and_has_full_access(self):
+        tok, claims = token()
+        r = self.get('/modules/', tok)
+        u = User.objects.get(pk=self.uid())
+        self.assertEqual((u.username, u.altvivo_sub, u.role, u.is_trial_account), ('priya@uni.edu.in', claims['sub'], Role.STUDENT, False))
+        self.assertFalse(u.has_usable_password())
+        self.assertTrue(u.has_full_access)
+        self.assertEqual(str(u.subscribed_until), time.strftime('%Y-%m-%d', time.gmtime(claims['entitlements']['xprism']['expires_at'])))
+        self.assertTrue(AuditLog.objects.filter(action='sso_login', target=u.username).exists())
+        # XPRISM's own policy gate still applies to new accounts.
+        self.assertEqual(r.status_code, 302)
+        self.assertIn('/consent', r['Location'])
+
+    def test_vip_roles_bypass_billing(self):
+        for role in ('SUPERADMIN', 'ADVISORY_BOARD'):
+            self.c = Client(HTTP_HOST=HOST)
+            tok, _ = token(role=role, mfa=True, email=f'{role.lower()}@altvivo.bio', entitlements={})
+            self.get('/modules/', tok)
+            u = User.objects.get(pk=self.uid())
+            self.assertTrue(u.has_full_access, role)
+        self.assertEqual(User.objects.get(email='superadmin@altvivo.bio').role, Role.SUPERADMIN)
+
+    def test_superadmin_requires_mfa_for_platform_admin_role(self):
+        tok, _ = token(role='SUPERADMIN', mfa=False, entitlements={})
+        self.get('/modules/', tok)
+        self.assertEqual(User.objects.get(pk=self.uid()).role, Role.STUDENT)
+
+    def test_expired_token_bounces_once_then_signs_in_again(self):
+        now = int(time.time())
+        tok, _ = token(iat=now - 2000, exp=now - 100)
+        r = self.get('/modules/', tok)
+        self.assertTrue(r['Location'].startswith('https://api.altvivo.bio/v1/auth/refresh/bounce?next=https%3A%2F%2Fxprism.altvivo.bio%2Fmodules%2F'))
+        again = self.get('/modules/', tok)
+        self.assertTrue(again['Location'].startswith('https://altvivo.bio/login?redirect='))
+
+    def test_revoked_session_is_rejected(self):
+        tok, claims = token()
+        self.get('/modules/', tok)
+        self.assertIsNotNone(self.uid())
+        self.redis.store[f"core:revoked:sid:{claims['sid']}"] = '1'
+        r = self.get('/modules/', tok)
+        self.assertTrue(r['Location'].startswith('https://altvivo.bio/login'))
+        self.assertIsNone(self.uid())
+
+    def test_forged_tokens_are_rejected(self):
+        other = rsa.generate_private_key(public_exponent=65537, key_size=2048)
+        pem = other.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption())
+        _, claims = token()
+        forged = jwt.encode(claims, pem, algorithm='RS256', headers={'kid': 'xprism-test'})
+        hs = jwt.encode(claims, 'x' * 32, algorithm='HS256', headers={'kid': 'xprism-test'})
+        for t in (forged, hs, 'garbage', token(iss='https://evil.example')[0]):
+            r = self.get('/modules/', t)
+            self.assertTrue(r['Location'].startswith('https://altvivo.bio/login'), t[:15])
+
+    def test_links_only_verified_non_demo_accounts(self):
+        mine = User.objects.create_user('fac1', email='priya@uni.edu.in', password='Pw-123456789', role=Role.FACULTY, email_verified=True)
+        tok, _ = token()
+        self.get('/modules/', tok)
+        self.assertEqual(int(self.uid()), mine.pk)
+
+        loose = User.objects.create_user('stud9', email='ravi@uni.edu.in', password='Pw-123456789', email_verified=False)
+        self.c = Client(HTTP_HOST=HOST)
+        tok, _ = token(email='ravi@uni.edu.in')
+        self.get('/modules/', tok)
+        self.assertNotEqual(int(self.uid()), loose.pk)
+
+        demo = User.objects.create_user(settings.SHARED_DEMO_USERNAMES[0], email='demo@xprism.test', password='Pw-123456789', email_verified=True)
+        self.c = Client(HTTP_HOST=HOST)
+        tok, _ = token(email='demo@xprism.test')
+        self.get('/modules/', tok)
+        self.assertNotEqual(int(self.uid()), demo.pk)
+
+    def test_inactive_college_is_refused(self):
+        college = College.objects.create(name='Closed College', code='closed', is_active=False)
+        User.objects.create_user('closed-1', email='priya@uni.edu.in', password='Pw-123456789', college=college, email_verified=True)
+        tok, _ = token()
+        r = self.get('/modules/', tok)
+        self.assertIn('notice=xprism_college_inactive', r['Location'])
+
+    def test_local_account_pages_hand_off_to_altvivo(self):
+        r = self.get('/accounts/login/?next=/modules/')
+        self.assertEqual(r['Location'], 'https://altvivo.bio/login?redirect=https%3A%2F%2Fxprism.altvivo.bio%2Fmodules%2F')
+        self.assertEqual(self.get('/accounts/signup/')['Location'].split('?')[0], 'https://altvivo.bio/register')
+        self.assertEqual(self.get('/accounts/password/reset/')['Location'], 'https://altvivo.bio/workspace/security')
+        self.assertEqual(self.get('/admin/login/?next=/admin/')['Location'].split('?')[0], 'https://altvivo.bio/login')
+
+    def test_exempt_paths_and_logout_and_topbar(self):
+        self.assertEqual(self.get('/healthz').status_code, 200)
+        hook = self.c.post('/api/resend/inbound', {}, secure=True)  # webhook: never sent to the AltVivo login
+        self.assertFalse(hook.has_header('Location'))
+        tok, _ = token()
+        self.get('/modules/', tok)
+        u = User.objects.get(pk=self.uid())
+        u.consent_version = settings.POLICY_VERSION
+        u.save()
+        page = self.get('/modules/', tok)
+        self.assertEqual(page.status_code, 200)
+        self.assertContains(page, '<altvivo-topbar app="xprism" api="https://api.altvivo.bio" home="https://altvivo.bio">')
+        self.assertEqual(page.content.count(b'<altvivo-topbar'), 1)
+        r = self.c.post('/accounts/logout/', secure=True)
+        self.assertEqual(r['Location'], 'https://altvivo.bio/logout?next=https%3A%2F%2Fxprism.altvivo.bio%2F')
