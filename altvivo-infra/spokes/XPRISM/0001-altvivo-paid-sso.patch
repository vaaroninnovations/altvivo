+"""AltVivo single sign-on and paid-entitlement gate for XPRISM.
+
+Active when ALTVIVO_JWKS_URL is set (config/settings.py). Layer 2 of the
+double gate: Caddy already calls altvivo-core's /v1/auth/verify?app=xprism
+before every request (layer 1); this middleware verifies the same
+`.altvivo.bio` access cookie locally so XPRISM never trusts the network alone.
+
+Per request (except exempt paths):
+  * `altvivo_at` is verified: RS256, issuer, expiry, JWKS key id, and the Redis
+    revocation list written by altvivo-core (instant cross-subdomain logout).
+  * Access requires `entitlements.xprism.active is True` (and an unexpired
+    `expires_at`), unless the role is in ALTVIVO_VIP_ROLES
+    (SUPERADMIN, ADVISORY_BOARD by default).
+  * Missing token  -> 302 https://altvivo.bio/login?redirect=<this URL>
+    Expired token  -> 302 https://api.altvivo.bio/v1/auth/refresh/bounce?next=<this URL>
+    Not paid       -> 302 https://altvivo.bio/workspace/upgrade?app=xprism&reason=subscription_required
+    (API / XHR callers get 401 / 403 JSON instead of redirects.)
+  * The AltVivo identity is synced to a local lab.User and signed in to the
+    Django session, so all existing XPRISM views keep working unchanged.
+  * XPRISM's own login, sign-up and password pages hand off to AltVivo; its
+    logout also ends the central AltVivo session.
+  * The shared <altvivo-topbar> is injected into every HTML page.
+"""
+from __future__ import annotations
+
+import datetime as dt
+import json
+import logging
+import os
+import re
+import threading
+import time
+import urllib.request
+from urllib.parse import urlencode
+
+import jwt
+from django.contrib.auth import login, logout
+from django.db import IntegrityError, transaction
+from django.http import HttpResponseRedirect, JsonResponse
+from django.utils import timezone
+
+log = logging.getLogger('altvivo')
+
+APP_ID = 'xprism'
+SESSION_SID = '_altvivo_sid'
+SESSION_SUB = '_altvivo_sub'
+SESSION_BOUNCE = '_altvivo_bounce_at'
+BOUNCE_LOOP_SECONDS = 20
+LOCAL_BACKEND = 'django.contrib.auth.backends.ModelBackend'
+
+
+def _env(name, default=''):
+    v = os.environ.get(name)
+    return default if v in (None, '') else v
+
+
+class Settings:
+    """Read once at import; values come from altvivo-infra/docker-compose.yml."""
+
+    jwks_url = _env('ALTVIVO_JWKS_URL')
+    issuer = _env('ALTVIVO_JWT_ISSUER', 'https://api.altvivo.bio')
+    cookie = _env('ALTVIVO_ACCESS_COOKIE', 'altvivo_at')
+    public_origin = _env('ALTVIVO_PUBLIC_ORIGIN', 'https://xprism.altvivo.bio').rstrip('/')
+    login_url = _env('ALTVIVO_LOGIN_URL', 'https://altvivo.bio/login')
+    register_url = _env('ALTVIVO_REGISTER_URL', 'https://altvivo.bio/register')
+    upgrade_url = _env('ALTVIVO_UPGRADE_URL', 'https://altvivo.bio/workspace/upgrade')
+    security_url = _env('ALTVIVO_SECURITY_URL', 'https://altvivo.bio/workspace/security')
+    logout_url = _env('ALTVIVO_LOGOUT_URL', 'https://altvivo.bio/logout')
+    bounce_url = _env('ALTVIVO_REFRESH_BOUNCE_URL', 'https://api.altvivo.bio/v1/auth/refresh/bounce')
+    api_url = _env('ALTVIVO_API_URL', 'https://api.altvivo.bio').rstrip('/')
+    home_url = _env('ALTVIVO_HOME_URL', 'https://altvivo.bio').rstrip('/')
+    embed_url = _env('ALTVIVO_EMBED_URL', 'https://embed.altvivo.bio/bar.js')
+    redis_url = _env('ALTVIVO_REDIS_URL')
+    redis_prefix = _env('ALTVIVO_REDIS_KEY_PREFIX', 'core:')
+    revocation_fail_open = _env('ALTVIVO_REVOCATION_FAIL_OPEN', 'true').lower() in ('1', 'true', 'yes')
+    vip_roles = frozenset(r.strip() for r in _env('ALTVIVO_VIP_ROLES', 'SUPERADMIN,ADVISORY_BOARD').split(',') if r.strip())
+    leeway = int(_env('ALTVIVO_LEEWAY_SECONDS', '5'))
+    jwks_ttl = int(_env('ALTVIVO_JWKS_CACHE_SECONDS', '300'))
+
+
+S = Settings
+
+# Never gated: health checks, static assets (gated at the edge by Caddy), and
+# the Resend inbound-mail webhook (authenticated by Resend's own signature).
+EXEMPT_PREFIXES = ('/healthz', '/assets/', '/favicon', '/robots.txt', '/api/resend/inbound')
+
+# XPRISM's own account pages that AltVivo now owns.
+HANDOFF = {
+    '/accounts/login/': 'login',
+    '/admin/login/': 'login',
+    '/accounts/signup/': 'register',
+    '/accounts/trial/': 'register',
+    '/accounts/password/reset/': 'security',
+    '/accounts/password/change/': 'security',
+}
+
+
+# ------------------------------------------------------------------- JWKS ---
+class JWKSCache:
+    """Refreshes every `ttl` s; refetches at most every 30 s on an unknown kid;
+    keeps the last good key set for 24 h if the IdP is unreachable."""
+
+    def __init__(self, url, ttl=300):
+        self.url, self.ttl = url, ttl
+        self._keys, self._fetched, self._attempt = {}, 0.0, 0.0
+        self._lock = threading.Lock()
+
+    def _fetch(self):
+        req = urllib.request.Request(self.url, headers={'Accept': 'application/json', 'User-Agent': 'xprism-altvivo-sso/1.0'})
+        with urllib.request.urlopen(req, timeout=3) as resp:  # noqa: S310 - URL from deployment config
+            doc = json.loads(resp.read().decode('utf-8'))
+        keys = {}
+        for k in doc.get('keys', []):
+            if k.get('kty') == 'RSA' and k.get('kid') and k.get('alg', 'RS256') == 'RS256' and k.get('use', 'sig') == 'sig':
+                keys[k['kid']] = jwt.PyJWK(k, algorithm='RS256').key
+        if not keys:
+            raise ValueError('JWKS has no usable RS256 keys')
+        return keys
+
+    def _refresh(self, force):
+        now = time.monotonic()
+        with self._lock:
+            if self._keys and not force and now - self._fetched < self.ttl:
+                return
+            if force and self._keys and now - self._attempt < 30:
+                return
+            self._attempt = now
+            try:
+                self._keys, self._fetched = self._fetch(), now
+            except Exception as exc:  # network, JSON or key errors
+                if self._keys and now - self._fetched < 24 * 3600:
+                    log.warning('JWKS refresh failed, using cached keys: %s', exc)
+                    return
+                raise
+
+    def key(self, kid):
+        self._refresh(False)
+        if kid not in self._keys:
+            self._refresh(True)
+        return self._keys[kid]
+
+
+_jwks = None
+_jwks_lock = threading.Lock()
+
+
+def _jwks_cache():
+    global _jwks
+    with _jwks_lock:
+        if _jwks is None or _jwks.url != S.jwks_url:
+            _jwks = JWKSCache(S.jwks_url, S.jwks_ttl)
+        return _jwks
+
+
+def reset_caches():
+    """For tests."""
+    global _jwks, _redis
+    with _jwks_lock:
+        _jwks = None
+    _redis = None
+
+
+class Expired(Exception):
+    pass
+
+
+class Invalid(Exception):
+    pass
+
+
+def verify(token):
+    """Verified claims dict, or raises Expired / Invalid."""
+    if not token or len(token) > 8192:
+        raise Invalid('missing token')
+    try:
+        header = jwt.get_unverified_header(token)
+    except jwt.PyJWTError as exc:
+        raise Invalid(str(exc)) from exc
+    if header.get('alg') != 'RS256' or not header.get('kid'):
+        raise Invalid('unexpected header')
+    try:
+        key = _jwks_cache().key(header['kid'])
+    except Exception as exc:
+        raise Invalid(f'no key for kid: {exc}') from exc
+    try:
+        claims = jwt.decode(token, key=key, algorithms=['RS256'], issuer=S.issuer, leeway=S.leeway,
+                            options={'require': ['exp', 'iat', 'sub', 'iss'], 'verify_aud': False})
+    except jwt.ExpiredSignatureError as exc:
+        raise Expired() from exc
+    except jwt.PyJWTError as exc:
+        raise Invalid(str(exc)) from exc
+    if not isinstance(claims.get('sid'), str) or not isinstance(claims.get('entitlements', {}), dict):
+        raise Invalid('malformed claims')
+    return claims
+
+
+# ------------------------------------------------------------- revocation ---
+_redis = None
+
+
+def _redis_client():
+    global _redis
+    if _redis is not None:
+        return _redis
+    if not S.redis_url:
+        return None
+    if _redis is None:
+        import redis
+
+        _redis = redis.Redis.from_url(S.redis_url, socket_timeout=0.5, socket_connect_timeout=0.5, decode_responses=True)
+    return _redis
+
+
+def set_redis(client):
+    """For tests, or to share an existing pool."""
+    global _redis
+    _redis = client
+
+
+def is_revoked(claims):
+    client = _redis_client()
+    if client is None:
+        return False
+    p = S.redis_prefix
+    try:
+        sid, before = client.mget(f"{p}revoked:sid:{claims['sid']}", f"{p}revoked:user:{claims['sub']}")
+    except Exception as exc:  # redis errors
+        log.warning('revocation check failed (%s): %s', 'allowing' if S.revocation_fail_open else 'denying', exc)
+        return not S.revocation_fail_open
+    if sid:
+        return True
+    try:
+        return before is not None and int(claims['iat']) < int(before)
+    except (TypeError, ValueError):
+        return False
+
+
+# ------------------------------------------------------------ entitlement ---
+def entitlement(claims):
+    """(allowed, expires_at_date_or_None, reason)."""
+    if claims.get('role') in S.vip_roles:
+        return True, None, 'vip'
+    ent = (claims.get('entitlements') or {}).get(APP_ID)
+    if not isinstance(ent, dict) or ent.get('active') is not True:
+        return False, None, 'subscription_required'
+    exp = ent.get('expires_at')
+    if exp is not None:
+        try:
+            exp = int(exp)
+        except (TypeError, ValueError):
+            return False, None, 'subscription_required'
+        if exp <= time.time():
+            return False, None, 'subscription_expired'
+        return True, dt.datetime.fromtimestamp(exp, tz=dt.timezone.utc).date(), 'paid'
+    return True, None, 'paid'
+
+
+# -------------------------------------------------------------- user sync ---
+def sync_user(claims, paid_until):
+    """Find or create the local XPRISM user for this AltVivo identity."""
+    from .models import Role, User
+
+    sub = str(claims['sub'])
+    email = str(claims.get('email') or '').lower()
+    verified = claims.get('email_verified') is True
+    user = User.objects.filter(altvivo_sub=sub).first()
+    if user is None:
+        with transaction.atomic():
+            candidate = None
+            if verified and email:
+                candidate = User.objects.filter(email__iexact=email, altvivo_sub__isnull=True).first()
+                # Link only accounts whose email XPRISM has verified too; never
+                # the public demo logins or anonymised accounts.
+                if candidate and not (candidate.email_verified and not candidate.is_shared_demo and not candidate.anonymised and candidate.is_active):
+                    candidate = None
+            if candidate is not None:
+                user = candidate
+                user.altvivo_sub = sub
+            else:
+                base = (email or f'altvivo-{sub}')[:150]
+                username, n = base, 1
+                while User.objects.filter(username=username).exists():
+                    n += 1
+                    username = f'{base[:140]}+av{n}'
+                first, _, last = str(claims.get('name') or '').partition(' ')
+                user = User(username=username, email=email, first_name=first[:150], last_name=last[:150],
+                            role=Role.STUDENT, altvivo_sub=sub, occupation=_occupation(claims.get('role')))
+                user.set_unusable_password()
+                if verified:
+                    user.email_verified, user.email_verified_at = True, timezone.now()
+            try:
+                user.save()
+            except IntegrityError:
+                user = User.objects.get(altvivo_sub=sub)
+        log.info('AltVivo %s linked to XPRISM user %s', sub, user.pk)
+
+    if not user.is_active:
+        return None
+    changed = []
+    # Paid AltVivo access is expressed through XPRISM's own field, so its
+    # existing has_full_access rules apply unchanged.
+    want = paid_until or (timezone.localdate() + dt.timedelta(days=1))
+    if user.subscribed_until != want:
+        user.subscribed_until = want
+        changed.append('subscribed_until')
+    if user.is_trial_account:
+        user.is_trial_account = False
+        changed.append('is_trial_account')
+    role = claims.get('role')
+    if role == 'SUPERADMIN' and claims.get('mfa') is True and user.role != Role.SUPERADMIN:
+        user.role = Role.SUPERADMIN
+        changed.append('role')
+    elif role != 'SUPERADMIN' and user.role == Role.SUPERADMIN and not user.has_usable_password() and not user.is_superuser:
+        user.role = Role.STUDENT  # promoted only through SSO: demote with the AltVivo role
+        changed.append('role')
+    if verified and not user.email_verified and user.email.lower() == email:
+        user.email_verified, user.email_verified_at = True, timezone.now()
+        changed += ['email_verified', 'email_verified_at']
+    if changed:
+        user.save(update_fields=changed + (['is_staff'] if 'role' in changed else []))
+    return user
+
+
+def _occupation(role):
+    return {'STUDENT': 'student', 'PI': 'faculty', 'INSTITUTE_ADMIN': 'faculty', 'ADVISORY_BOARD': 'faculty'}.get(role, 'researcher')
+
+
+# ---------------------------------------------------------------- helpers ---
+def _self_url(request):
+    return S.public_origin + request.get_full_path()
+
+
+def _wants_json(request):
+    accept = request.headers.get('Accept', '')
+    return (request.path.startswith('/api/') or request.headers.get('X-Requested-With') == 'XMLHttpRequest'
+            or ('application/json' in accept and 'text/html' not in accept))
+
+
+def _redirect_or_json(request, url, status, error):
+    """API / XHR callers get JSON; page loads and form posts get a redirect."""
+    if _wants_json(request):
+        return JsonResponse({'error': error, 'redirect': url}, status=status)
+    return HttpResponseRedirect(url)
+
+
+def login_redirect(request):
+    return _redirect_or_json(request, f'{S.login_url}?{urlencode({"redirect": _self_url(request)})}', 401, 'unauthenticated')
+
+
+def upgrade_redirect(request, reason):
+    return _redirect_or_json(request, f'{S.upgrade_url}?{urlencode({"app": APP_ID, "reason": reason})}', 403, reason)
+
+
+def central_logout_url():
+    return f'{S.logout_url}?{urlencode({"next": S.public_origin + "/"})}'
+
+
+TOPBAR = None
+
+
+def _topbar_html():
+    global TOPBAR
+    if TOPBAR is None:
+        from django.utils.html import escape
+
+        TOPBAR = (f'<script src="{escape(S.embed_url)}" defer crossorigin="anonymous"></script>'
+                  f'<altvivo-topbar app="{APP_ID}" api="{escape(S.api_url)}" home="{escape(S.home_url)}"></altvivo-topbar>').encode()
+    return TOPBAR
+
+
+_BODY_RE = re.compile(rb'<body\b[^>]*>', re.IGNORECASE)
+
+
+# ------------------------------------------------------------- middleware ---
+class AltVivoSSOMiddleware:
+    """Place directly after django.contrib.auth.middleware.AuthenticationMiddleware."""
+
+    def __init__(self, get_response):
+        self.get_response = get_response
+        if not S.jwks_url:
+            raise RuntimeError('AltVivoSSOMiddleware needs ALTVIVO_JWKS_URL')
+        if not S.redis_url:
+            log.warning('ALTVIVO_REDIS_URL is not set: central sign-out reaches XPRISM only when the access token expires (<= 15 min)')
+
+    def __call__(self, request):
+        request.altvivo = None
+        path = request.path
+        if path.startswith(EXEMPT_PREFIXES):
+            return self.get_response(request)
+
+        handoff = HANDOFF.get(path)
+        if handoff:
+            target = request.GET.get('next') or '/'
+            back = S.public_origin + (target if target.startswith('/') and not target.startswith('//') else '/')
+            if handoff == 'security':
+                return HttpResponseRedirect(S.security_url)
+            base = S.login_url if handoff == 'login' else S.register_url
+            return HttpResponseRedirect(f'{base}?{urlencode({"redirect": back})}')
+
+        early = self._gate(request)
+        if early is not None:
+            return early
+
+        response = self.get_response(request)
+
+        match = getattr(request, 'resolver_match', None)
+        if match is not None and match.url_name == 'logout' and 300 <= response.status_code < 400:
+            return HttpResponseRedirect(central_logout_url())
+        return self._inject_topbar(response)
+
+    def _gate(self, request):
+        token = request.COOKIES.get(S.cookie)
+        claims, expired = None, False
+        if token:
+            try:
+                claims = verify(token)
+            except Expired:
+                expired = True
+            except Invalid as exc:
+                log.info('rejected AltVivo token: %s', exc)
+        if claims is not None and is_revoked(claims):
+            claims = None
+
+        if claims is None:
+            had_session = bool(request.session.get(SESSION_SID))
+            if request.user.is_authenticated:
+                logout(request)
+            if expired:
+                recently = time.time() - float(request.session.get(SESSION_BOUNCE, 0) or 0) < BOUNCE_LOOP_SECONDS
+                if not recently:
+                    if _wants_json(request):
+                        return JsonResponse({'error': 'session_expired', 'refreshUrl': f'{S.api_url}/v1/auth/refresh'}, status=401)
+                    request.session[SESSION_BOUNCE] = time.time()
+                    return HttpResponseRedirect(f'{S.bounce_url}?{urlencode({"next": _self_url(request)})}')
+            if had_session:
+                log.info('AltVivo session ended; signing out locally')
+            return login_redirect(request)
+
+        allowed, paid_until, reason = entitlement(claims)
+        if not allowed:
+            if request.user.is_authenticated:
+                logout(request)
+            return upgrade_redirect(request, reason)
+
+        user = sync_user(claims, paid_until)
+        if user is None:
+            return _redirect_or_json(request, f'{S.home_url}/workspace?{urlencode({"notice": "xprism_account_disabled"})}', 403, 'account_disabled')
+        if user.college_id and user.college and not user.college.is_active and not user.is_platform_admin:
+            return _redirect_or_json(request, f'{S.home_url}/workspace?{urlencode({"notice": "xprism_college_inactive"})}', 403, 'college_inactive')
+
+        if (not request.user.is_authenticated or request.user.pk != user.pk
+                or request.session.get(SESSION_SID) != claims['sid']):
+            login(request, user, backend=LOCAL_BACKEND)  # rotates the session key
+            request.session[SESSION_SID] = claims['sid']
+            request.session[SESSION_SUB] = claims['sub']
+            from .permissions import audit
+
+            audit(request, 'sso_login', user.username, altvivo_sub=claims['sub'], altvivo_session=claims['sid'],
+                  access=reason, plan=((claims.get('entitlements') or {}).get(APP_ID) or {}).get('plan'))
+        elif SESSION_BOUNCE in request.session:
+            del request.session[SESSION_BOUNCE]
+        request.altvivo = claims
+        return None
+
+    @staticmethod
+    def _inject_topbar(response):
+        ctype = response.get('Content-Type', '')
+        if (response.status_code != 200 or getattr(response, 'streaming', False) or 'text/html' not in ctype
+                or response.get('Content-Encoding')):
+            return response
+        body = response.content
+        if b'<altvivo-topbar' in body:
+            return response
+        m = _BODY_RE.search(body)
+        if not m:
+            return response
+        response.content = body[:m.end()] + _topbar_html() + body[m.end():]
+        if response.has_header('Content-Length'):
+            response['Content-Length'] = str(len(response.content))
+        return response
