 # ==============================================================================
-# aMaze Behavioral Suite - Nginx Reverse Proxy Configuration
-# ==============================================================================
-# Installation on Hostinger VPS (Ubuntu/Debian):
-# 1. Copy this file: sudo cp nginx.conf /etc/nginx/sites-available/amaze
-# 2. Link site:      sudo ln -s /etc/nginx/sites-available/amaze /etc/nginx/sites-enabled/
-# 3. Test config:    sudo nginx -t
-# 4. Reload nginx:   sudo systemctl reload nginx
-# 5. SSL with certbot: sudo certbot --nginx -d yourdomain.com
+# aMaze container nginx (nginxinc/nginx-unprivileged, uid 101, port 8080)
+# Static SPA only. TLS, HSTS, CSP and the paid-access check happen in Caddy
+# in front of this container; this file must work with a read-only root FS.
 # ==============================================================================
+worker_processes auto;
+pid /tmp/nginx.pid;
+error_log /dev/stderr warn;
+
+events {
+    worker_connections 1024;
+}
+
+http {
+    include       /etc/nginx/mime.types;
+    default_type  application/octet-stream;
 
-server {
-    listen 80;
-    listen [::]:80;
-    server_name yourdomain.com www.yourdomain.com; # Replace with your domain or VPS IP
+    # Writable paths for a read-only root filesystem (tmpfs /tmp in compose).
+    client_body_temp_path /tmp/client_temp;
+    proxy_temp_path       /tmp/proxy_temp;
+    fastcgi_temp_path     /tmp/fastcgi_temp;
+    uwsgi_temp_path       /tmp/uwsgi_temp;
+    scgi_temp_path        /tmp/scgi_temp;
 
-    # Allow large video uploads (behavior videos can be hundreds of megabytes)
-    client_max_body_size 500M;
-    client_body_buffer_size 128k;
+    log_format json escape=json '{"time":"$time_iso8601","status":$status,"method":"$request_method",'
+                                '"uri":"$uri","bytes":$body_bytes_sent,"rt":$request_time,"ua":"$http_user_agent"}';
+    access_log /dev/stdout json;
+
+    server_tokens off;
+    sendfile on;
+    tcp_nopush on;
+    keepalive_timeout 65;
+    client_max_body_size 1m;
 
-    # Gzip compression for high frontend performance
     gzip on;
     gzip_vary on;
     gzip_min_length 1024;
     gzip_proxied any;
-    gzip_types
-        text/plain
-        text/css
-        text/javascript
-        application/javascript
-        application/json
-        application/x-javascript
-        text/xml
-        application/xml
-        application/xml+rss
-        image/svg+xml;
+    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/wasm;
 
-    # Reverse proxy to Node.js backend
-    location / {
-        proxy_pass http://127.0.0.1:3000;
-        proxy_http_version 1.1;
+    map $sent_http_content_type $no_sniff { default "nosniff"; }
 
-        # WebSocket support (for live camera tracking & real-time updates)
-        proxy_set_header Upgrade $http_upgrade;
-        proxy_set_header Connection "upgrade";
+    server {
+        listen 8080;
+        listen [::]:8080;
+        server_name _;
+        root /usr/share/nginx/html;
 
-        # Standard proxy headers
-        proxy_set_header Host $host;
-        proxy_set_header X-Real-IP $remote_addr;
-        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
-        proxy_set_header X-Forwarded-Proto $scheme;
+        add_header X-Content-Type-Options $no_sniff always;
+        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
 
-        # Timeouts for long video uploads and processing
-        proxy_connect_timeout 300s;
-        proxy_send_timeout 300s;
-        proxy_read_timeout 300s;
+        location = /healthz {
+            access_log off;
+            default_type text/plain;
+            return 200 "ok\n";
+        }
 
-        # Disable buffering for real-time video streaming
-        proxy_buffering off;
-    }
+        # Content-hashed bundles from Vite: cache forever.
+        location /assets/ {
+            expires 1y;
+            add_header Cache-Control "public, max-age=31536000, immutable" always;
+            add_header X-Content-Type-Options $no_sniff always;
+            try_files $uri =404;
+        }
+
+        # The retired Express API. Data now lives in the browser and in AltVivo
+        # (sign-in, contact form, vault) - fail loudly instead of returning HTML.
+        location /api/ {
+            default_type application/json;
+            return 410 '{"error":"gone","message":"This endpoint moved to https://api.altvivo.bio"}';
+        }
+
+        # Never serve dotfiles or source maps from the image.
+        location ~ /\. { deny all; }
+        location ~ \.map$ { return 404; }
 
-    # Cache static frontend assets directly
-    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
-        proxy_pass http://127.0.0.1:3000;
-        proxy_set_header Host $host;
-        expires 1y;
-        add_header Cache-Control "public, max-age=31536000, immutable";
+        # SPA: every other route renders index.html, which must never be cached
+        # (it names the current hashed bundles).
+        location / {
+            try_files $uri $uri/ /index.html;
+            add_header Cache-Control "no-cache" always;
+            add_header X-Content-Type-Options $no_sniff always;
+        }
     }
 }
