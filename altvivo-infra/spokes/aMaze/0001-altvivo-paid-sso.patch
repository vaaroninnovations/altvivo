+# aMaze Behavioral Neuroscience Suite - static SPA for amaze.altvivo.bio
+#
+# Build: Node 22 LTS (Node 20 reached end-of-life in April 2026).
+# Serve: unprivileged nginx on :8080, behind Caddy, which admits a request
+#        only after altvivo-core confirms a paid aMaze entitlement
+#        (forward_auth) - so unpaid visitors cannot load even static assets.
+#
+#   docker compose build amaze             (from /opt/altvivo/altvivo-infra)
+#   docker build --build-arg VITE_TRACKING_API_URL=https://... -t altvivo/amaze .
 # ==============================================================================
+ARG NODE_IMAGE=node:22.23.3-alpine3.23
+ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.30.6-alpine
 
-# Stage 1: Build the Frontend
-FROM node:20-alpine AS builder
-
+# ------------------------------------------------------------------ build ----
+FROM ${NODE_IMAGE} AS build
 WORKDIR /app
-
-# Copy package manifests first for optimal layer caching
-COPY package*.json ./
-
-# Install all dependencies including devDependencies for build
-RUN npm ci
-
-# Copy all source files
+COPY package.json package-lock.json ./
+RUN npm ci --no-audit --no-fund
 COPY . .
-
-# Build production frontend bundle into /app/dist
+# Public build-time settings, baked into the bundle.
+ARG VITE_ALTVIVO_API_URL=https://api.altvivo.bio
+ARG VITE_ALTVIVO_HOME_URL=https://altvivo.bio
+ARG VITE_TRACKING_API_URL=
+ENV VITE_ALTVIVO_API_URL=${VITE_ALTVIVO_API_URL} \
+    VITE_ALTVIVO_HOME_URL=${VITE_ALTVIVO_HOME_URL} \
+    VITE_TRACKING_API_URL=${VITE_TRACKING_API_URL}
