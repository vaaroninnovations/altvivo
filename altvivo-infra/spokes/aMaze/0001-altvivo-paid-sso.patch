new file mode 100644
index 0000000..5563dd7
--- /dev/null
+++ b/src/lib/altvivo.ts
@@ -0,0 +1,132 @@
+// AltVivo single sign-on client for the aMaze single-page app.
+//
+// aMaze is served as static files at amaze.altvivo.bio behind Caddy, which
+// admits a request only when altvivo-core confirms a signed-in user with an
+// active aMaze entitlement (forward_auth). Identity therefore lives at the
+// IdP: this module reads the session from api.altvivo.bio using the shared
+// `.altvivo.bio` cookies and never sees passwords or refresh tokens.
+
+const env = import.meta.env;
+
+export const ALTVIVO = {
+  apiUrl: (env.VITE_ALTVIVO_API_URL || "https://api.altvivo.bio").replace(/\/$/, ""),
+  homeUrl: (env.VITE_ALTVIVO_HOME_URL || "https://altvivo.bio").replace(/\/$/, ""),
+  appId: "amaze",
+} as const;
+
+export interface AltVivoEntitlement {
+  active: boolean;
+  level: string;
+  plan: string | null;
+  expiresAt: string | null;
+}
+
+export interface AltVivoUser {
+  id: string;
+  email: string;
+  name: string;
+  role: string;
+  orgId: string | null;
+  tier: string;
+  emailVerified: boolean;
+  creditsRemaining: number;
+  entitlements: Record<string, AltVivoEntitlement>;
+  accessTokenExpiresAt: string;
+}
+
+function readCookie(name: string): string | null {
+  for (const part of document.cookie ? document.cookie.split("; ") : []) {
+    const i = part.indexOf("=");
+    if (part.slice(0, i) === name) return decodeURIComponent(part.slice(i + 1));
+  }
+  return null;
+}
+
+/** Signed double-submit CSRF token shared across *.altvivo.bio. */
+export async function csrfToken(): Promise<string> {
+  const existing = readCookie("altvivo_csrf");
+  if (existing) return existing;
+  const res = await fetch(`${ALTVIVO.apiUrl}/v1/auth/csrf`, { credentials: "include" });
+  if (!res.ok) throw new Error("Could not start a secure session");
+  return ((await res.json()) as { csrfToken: string }).csrfToken;
+}
+
+/** Rotates the refresh cookie; true when a fresh access token was issued. */
+export async function refreshSession(): Promise<boolean> {
+  try {
+    const res = await fetch(`${ALTVIVO.apiUrl}/v1/auth/refresh`, {
+      method: "POST",
+      credentials: "include",
+      headers: { "X-CSRF-Token": await csrfToken(), Accept: "application/json" },
+    });
+    return res.ok;
+  } catch {
+    return false;
+  }
+}
+
+/** The signed-in AltVivo user, or null. Refreshes once if the access token lapsed. */
+export async function fetchSession(): Promise<AltVivoUser | null> {
+  const get = () => fetch(`${ALTVIVO.apiUrl}/v1/auth/session`, { credentials: "include", headers: { Accept: "application/json" } });
+  let res = await get();
+  if (res.status === 401 && (await refreshSession())) res = await get();
+  if (!res.ok) return null;
+  return ((await res.json()) as { user: AltVivoUser }).user;
+}
+
+/** Full-page hand-off to the AltVivo sign-in page, returning here afterwards. */
+export function signInRedirect(returnTo: string = window.location.href): void {
+  window.location.assign(`${ALTVIVO.homeUrl}/login?${new URLSearchParams({ redirect: returnTo })}`);
+}
+
+/** Ends the AltVivo session on every app, then returns to aMaze. */
+export function signOutRedirect(): void {
+  window.location.assign(`${ALTVIVO.homeUrl}/logout?${new URLSearchParams({ next: `${window.location.origin}/` })}`);
+}
+
+export function upgradeUrl(reason = "subscription_required"): string {
+  return `${ALTVIVO.homeUrl}/workspace/upgrade?${new URLSearchParams({ app: ALTVIVO.appId, reason })}`;
+}
+
+/**
+ * Short-lived bearer token for the video-tracking service
+ * (VITE_TRACKING_API_URL). Issued by altvivo-core for this app only
+ * (audience-scoped, a few minutes), so the HttpOnly session cookie is never
+ * exposed to JavaScript.
+ */
+export async function fetchAppToken(): Promise<{ token: string; expiresAt: number } | null> {
+  try {
+    const res = await fetch(`${ALTVIVO.apiUrl}/v1/auth/app-token`, {
+      method: "POST",
+      credentials: "include",
+      headers: { "Content-Type": "application/json", "X-CSRF-Token": await csrfToken(), Accept: "application/json" },
+      body: JSON.stringify({ app: ALTVIVO.appId }),
+    });
+    if (!res.ok) return null;
+    const data = (await res.json()) as { token: string; expiresAt: string };
+    return { token: data.token, expiresAt: Date.parse(data.expiresAt) || Date.now() + 60_000 };
+  } catch {
+    return null;
+  }
+}
+
+/** Public contact form, stored by altvivo-core (Turnstile-free, rate limited). */
+export async function sendContactMessage(body: {
+  name: string;
+  email: string;
+  institution: string;
+  category: string;
+  subject: string;
+  message: string;
+}): Promise<void> {
+  const res = await fetch(`${ALTVIVO.apiUrl}/v1/public/contact`, {
+    method: "POST",
+    credentials: "include",
+    headers: { "Content-Type": "application/json", "X-CSRF-Token": await csrfToken(), Accept: "application/json" },
+    body: JSON.stringify({ ...body, app: ALTVIVO.appId }),
+  });
+  if (!res.ok) {
+    const data = (await res.json().catch(() => null)) as { error?: { message?: string } } | null;
+    throw new Error(data?.error?.message ?? "Your message could not be sent");
+  }
+}
