diff --git a/public/theme-init.js b/public/theme-init.js
new file mode 100644
index 0000000..d7f4b13
--- /dev/null
+++ b/public/theme-init.js
@@ -0,0 +1,12 @@
+// Applies the saved/system colour scheme before first paint (no flash).
+// A file rather than inline script so the CSP needs no 'unsafe-inline'.
+try {
+  let theme = localStorage.getItem("theme");
+  if (theme === "system" || !theme) {
+    let prefersDark = window.matchMedia(
+      "(prefers-color-scheme: dark)",
+    ).matches;
+    theme = prefersDark ? "dark" : "light";
+  }
+  document.documentElement.classList.add(theme);
+} catch (e) {}
