# PhytoNet AI - Network Pharmacology & Molecular Docking
# Enable with: ./scripts/spoke-route.sh enable phytonet   (paid gate included)
@phytonet host phytonet.altvivo.bio
handle @phytonet {
	request_body {
		max_size 25MB
	}
	header {
		defer
		X-Frame-Options "SAMEORIGIN"
		?Content-Security-Policy {env.SPOKE_CSP_DEFAULT}
	}
	route {
		request_header -X-AltVivo-*
		request_header -X-Internal-*
		import paid_gate phytonet
		import spoke_upstream phytonet:8000
	}
}
