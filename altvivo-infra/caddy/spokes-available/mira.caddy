# MIRA - Automated Manuscript Screening & Reference Verification
# Enable with: ./scripts/spoke-route.sh enable mira   (paid gate included)
@mira host mira.altvivo.bio
handle @mira {
	request_body {
		max_size 50MB
	}
	header {
		defer
		X-Frame-Options "SAMEORIGIN"
		?Content-Security-Policy {env.SPOKE_CSP_DEFAULT}
	}
	route {
		request_header -X-AltVivo-*
		request_header -X-Internal-*
		import paid_gate mira
		import spoke_upstream mira:8000
	}
}
