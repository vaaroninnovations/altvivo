# =============================================================================
# Phase-2 holding route (imported inside the wildcard site block).
# Hosts listed here are served the altvivo-web "Launching Soon on AltVivo" page
# (/coming-soon?app=<app_id>). When a spoke is enabled through
# scripts/spoke-route.sh, its spokes-enabled/<app>.caddy handle is evaluated
# first, so the entry below becomes inert; the script also removes it.
# =============================================================================

@phase2 host pharmadme.altvivo.bio stat.altvivo.bio phytonet.altvivo.bio mira.altvivo.bio
handle @phase2 {
	header {
		defer
		X-Frame-Options "SAMEORIGIN"
		?Content-Security-Policy {env.WEB_CSP_FALLBACK}
		Cache-Control "public, max-age=60"
	}

	# Next.js assets for the holding page are served as-is.
	@portal_assets path /_next/* /favicon.ico /brand/* /fonts/* /api/health
	handle @portal_assets {
		import upstream altvivo-web:3000
	}

	handle {
		rewrite * /coming-soon?app={labels.2}
		import upstream altvivo-web:3000
	}
}
