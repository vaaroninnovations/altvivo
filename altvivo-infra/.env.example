# =============================================================================
# AltVivo production environment
# -----------------------------------------------------------------------------
#   sudo ./scripts/generate-secrets.sh
# copies this file to .env (mode 600) and replaces every __GEN_*__ placeholder
# with a fresh random value. Fill in the blank third-party credentials by hand.
# NEVER commit .env.
# =============================================================================

# ----------------------------------------------------------------- Global ----
TZ=UTC
CADDY_VERSION=2.10.0

# --------------------------------------------------------- TLS / Cloudflare --
# Cloudflare API token scoped to: Zone > DNS > Edit, Zone > Zone > Read,
# limited to the altvivo.bio zone only.
CF_API_TOKEN=
ACME_EMAIL=ops@altvivo.bio
# Use the staging CA while testing to avoid Let's Encrypt rate limits:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Directory holding the built <altvivo-topbar> bundle (Module 4).
EMBED_DIST_DIR=./embed/dist

# ------------------------------------------------------- Images / builds ------
CORE_IMAGE=altvivo/core:latest
CORE_BUILD_CONTEXT=../altvivo-core
WEB_IMAGE=altvivo/web:latest
WEB_BUILD_CONTEXT=../altvivo-web
# Spoke repositories cloned next to altvivo-infra (/opt/altvivo/XPRISM, /opt/altvivo/aMaze)
# with the patches in altvivo-infra/spokes/ applied.
XPRISM_IMAGE=altvivo/xprism:latest
XPRISM_DIR=../XPRISM
XPRISM_WORKERS=3
XPRISM_LOG_LEVEL=WARNING
AMAZE_IMAGE=altvivo/amaze:latest
AMAZE_DIR=../aMaze
# External video-tracking service used by the aMaze frontend (baked in at build
# time). It must verify AltVivo app tokens (aud=amaze) via the JWKS. Leave
# empty to disable server-side tracking. Add its origin to SPOKE_CSP_AMAZE.
AMAZE_TRACKING_API_URL=

# Docker app-tier subnet (data tier is fixed at 172.30.10.0/24).
APP_SUBNET=172.30.0.0/24

# --------------------------------------------------------------- Postgres ----
POSTGRES_SUPERUSER=altvivo_admin
POSTGRES_SUPERUSER_PASSWORD=__GEN_HEX__
CORE_MIGRATOR_PASSWORD=__GEN_HEX__
CORE_APP_PASSWORD=__GEN_HEX__
CORE_READONLY_PASSWORD=__GEN_HEX__
CORE_DB_POOL_SIZE=20
# Spokes that get their own database on FIRST boot (aMaze stores JSON files and
# needs none). Later spokes are added with scripts/provision-spoke-db.sh <app_id>.
SPOKE_DATABASES=xprism
XPRISM_DB_PASSWORD=__GEN_HEX__
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB

# ------------------------------------------------------------------ Redis ----
# One ACL user per service; each can only touch keys under "<user>:*".
# aMaze is a static site with no server, so it has no Redis user.
REDIS_SPOKES=xprism
REDIS_CORE_PASSWORD=__GEN_HEX__
REDIS_XPRISM_PASSWORD=__GEN_HEX__
REDIS_BACKUP_PASSWORD=__GEN_HEX__

# ------------------------------------------------------ altvivo-core (IdP) ----
CORE_LOG_LEVEL=info
# Key id of secrets/jwt/public.pem (published in JWKS). Set by the generator.
JWT_KID=__GEN_KID__
# 32-byte AES-256-GCM key (base64) for encrypting users.mfa_secret at rest.
MFA_ENCRYPTION_KEY=__GEN_B64__
CSRF_SECRET=__GEN_HEX__
# HMAC pepper mixed into SHA-256 refresh-token hashes before storage.
REFRESH_TOKEN_PEPPER=__GEN_HEX__
# previous_hash of the very first audit_logs row (64 hex chars).
AUDIT_CHAIN_GENESIS=__GEN_HEX__

# Spoke -> core server-to-server tokens (credit debit, vault writes).
XPRISM_SERVICE_TOKEN=__GEN_HEX__

# OAuth 2.0 (redirect URIs: https://api.altvivo.bio/v1/auth/oauth/<provider>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Use https://sandbox.orcid.org for testing.
ORCID_BASE_URL=https://orcid.org

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe (customers outside India, USD, zero-rated). Webhook: https://api.altvivo.bio/v1/billing/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, invoice.paid,
# customer.subscription.updated, customer.subscription.deleted, charge.refunded.
# Link a plan's recurring Stripe price in /admin to sell it as an auto-renewing subscription.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay (India, INR prepaid terms via Orders: UPI, cards, NetBanking).
# Webhook: https://api.altvivo.bio/v1/billing/webhooks/razorpay
# Events: payment.captured, order.paid, payment.failed, refund.processed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2 (S3-compatible). Core issues pre-signed URLs and manages the vault.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_VAULT=altvivo-vault
R2_BUCKET_UPLOADS=altvivo-uploads
R2_PRESIGN_TTL_SECONDS=300
# R2 bucket CORS must allow PUT from https://amaze.altvivo.bio with headers
# content-type, content-length and x-amz-checksum-sha256 (browser uploads).

# Seller identity printed on GST tax invoices, proformas and credit notes.
# Online checkout and proformas are disabled until the first four are set.
# SELLER_STATE_CODE must equal the first two digits of SELLER_GSTIN.
# Use a multi-line address with literal 
 separators.
SELLER_LEGAL_NAME=Aaron Innovations
SELLER_TRADE_NAME=AltVivo
SELLER_GSTIN=
SELLER_PAN=
SELLER_ADDRESS=
SELLER_STATE_CODE=
SELLER_EMAIL=billing@altvivo.bio
SELLER_PHONE=
# ARN of the Letter of Undertaking for zero-rated exports (printed on USD invoices).
SELLER_LUT_REFERENCE=
# Bank account printed on proforma invoices for NEFT / RTGS.
SELLER_BANK_NAME=
SELLER_BANK_ACCOUNT_NAME=
SELLER_BANK_ACCOUNT_NUMBER=
SELLER_BANK_IFSC=
SELLER_BANK_BRANCH=
PROFORMA_VALIDITY_DAYS=30

# Public R2 bucket + CDN origin for advisory-board portraits (set both or neither).
R2_BUCKET_PUBLIC=
R2_PUBLIC_BASE_URL=

# Legal identity shown in the Privacy Policy, Terms and Contact pages.
# Entity and address default to SELLER_LEGAL_NAME / SELLER_ADDRESS.
LEGAL_ENTITY_NAME=Aaron Innovations
LEGAL_REGISTERED_ADDRESS=
# Corporate Identity Number (companies registered in India).
LEGAL_CIN=
LEGAL_PRIVACY_EMAIL=privacy@altvivo.bio
LEGAL_SALES_EMAIL=sales@altvivo.bio
# DPDPA 2023: person who answers data-protection grievances.
LEGAL_GRIEVANCE_OFFICER_NAME=
LEGAL_GRIEVANCE_OFFICER_EMAIL=grievance@altvivo.bio
LEGAL_GRIEVANCE_OFFICER_PHONE=
# Seat of arbitration and courts named in the Terms.
LEGAL_JURISDICTION_CITY=Bengaluru

# Contact-form enquiries are delivered here (Reply-To = the sender).
SUPPORT_EMAIL=support@altvivo.bio

# Transactional email (verification, password reset, waitlist notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AltVivo <no-reply@altvivo.bio>

# ------------------------------------------------------------------ Spokes ----
XPRISM_DJANGO_SECRET_KEY=__GEN_HEX__

# --------------------------------------------- Content-Security-Policy -------
# Applied by Caddy only when the upstream did not send its own CSP header.
# XPRISM mirrors its own nginx policy: its templates and 43 experiment pages use
# inline scripts, so 'unsafe-inline' stays until those move to files/nonces.
# aMaze has no inline scripts. If AMAZE_TRACKING_API_URL is set, add its origin to connect-src.
WEB_CSP_FALLBACK="default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://js.stripe.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.stripe.com https://*.razorpay.com; font-src 'self' data:; connect-src 'self' https://api.altvivo.bio https://api.stripe.com https://*.razorpay.com; frame-src https://challenges.cloudflare.com https://js.stripe.com https://hooks.stripe.com https://api.razorpay.com https://checkout.razorpay.com; frame-ancestors 'self'; form-action 'self' https://api.altvivo.bio; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
SPOKE_CSP_XPRISM="default-src 'self'; script-src 'self' 'unsafe-inline' https://embed.altvivo.bio https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googletagmanager.com https://*.google-analytics.com; font-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://api.altvivo.bio https://*.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://altvivo.bio; object-src 'none'; upgrade-insecure-requests"
SPOKE_CSP_AMAZE="default-src 'self'; script-src 'self' https://embed.altvivo.bio; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://api.altvivo.bio; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://altvivo.bio; object-src 'none'; upgrade-insecure-requests"
SPOKE_CSP_DEFAULT="default-src 'self'; script-src 'self' https://embed.altvivo.bio; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.altvivo.bio; worker-src 'self' blob:; frame-ancestors 'self'; form-action 'self' https://altvivo.bio https://api.altvivo.bio; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

# ---------------------------------------------------------------- Backups ----
BACKUP_LOCAL_DIR=/var/backups/altvivo
BACKUP_LOCAL_RETENTION_DAYS=7
# age PUBLIC key(s), one per line. Keep the matching private key OFF this server.
BACKUP_AGE_RECIPIENTS_FILE=./secrets/backup/age_recipients.txt
# rclone remote:path (configure with `sudo rclone config`), e.g. r2backup:altvivo-backups/prod
BACKUP_RCLONE_REMOTE=
BACKUP_REMOTE_RETENTION_DAYS=35
# Optional dead-man's-switch URL (e.g. healthchecks.io). "/fail" is appended on error.
BACKUP_HEARTBEAT_URL=
